{
  "name": "@lpm.dev/neo.string-width",
  "version": "1.0.0",
  "description": "Unicode 16 string-width utilities for terminal text, emoji, CJK, and ANSI sequences",
  "packageManager": "lpm@0.73.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".lpm/skills",
    "README.md",
    "CHANGELOG.md",
    "BENCHMARKS.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "lpm pack",
    "dev": "lpm pack -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json --noEmit",
    "audit": "lpm audit --fail-on=vuln && lpm audit signatures",
    "check": "lpm run typecheck && lpm lint src test scripts && lpm run test && lpm run build",
    "clean": "rm -rf dist",
    "generate-unicode-data": "tsc -p tsconfig.scripts.json && node .build/scripts/generate-unicode-data.js",
    "publish:check": "lpm publish --check --min-score 80",
    "prepublishOnly": "lpm run clean && lpm run audit && lpm run check"
  },
  "keywords": [
    "lpm",
    "string-width",
    "visual-width",
    "east-asian-width",
    "unicode",
    "terminal",
    "cli",
    "width",
    "column",
    "fullwidth",
    "emoji",
    "ansi",
    "typescript",
    "tree-shakeable"
  ],
  "author": "neo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.string-width"
  },
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.string-width/issues"
  },
  "homepage": "https://github.com/ne-ooo/neo.string-width#readme",
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "@lpm.dev/neo.ansi": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "string-width": "8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "lpm": ">=0.73.0"
  },
  "lpm": {
    "autoInstallPeers": false,
    "minimumReleaseAge": 259200,
    "scriptPolicy": "deny",
    "strictPeerDependencies": true
  }
}
